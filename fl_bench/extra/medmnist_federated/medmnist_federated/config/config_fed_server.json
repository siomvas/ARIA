{
    "format_version": 2,
    "min_clients": 4,
    "num_rounds": 50,
    "seed": 111,
    "hyperion": false,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/fl_bench/medmnist/splits/combo/alpha=0.1_seed=111",
    "alpha": 0.1,
    "model_path": "fl_bench.networks.medmnist_nets.resnet_18_scratch",
    "server": {
        "heart_beat_timeout": 600
    },
    "task_data_filters": [],
    "task_result_filters": [],
    "components": [
        {
            "id": "data_splitter",
            "path": "fl_bench.medmnist.src.utils.ComboSplitter",
            "args": {
                "split_dir": "{TRAIN_SPLIT_ROOT}",
                "num_sites": "{min_clients}",
                "alpha": "{alpha}",
                "seed": "{seed}",
                "hyperion": "{hyperion}"
            }
        },
        {
            "id": "persistor",
            "name": "PTFileModelPersistor",
            "args": {
                "model": "model",
                "source_ckpt_file_full_name": null
            }
        },
        {
            "id": "model",
            "path": "{model_path}",
            "args": {
                "seed": "{seed}"
            }
        },
        {
            "id": "shareable_generator_base",
            "name": "FullModelShareableGenerator",
            "args": {}
        },
        {
            "id": "shareable_generator_fedopt",
            "path": "fl_bench.utils.fedopt.PTFedOptModelShareableGenerator",
            "args": {
                "device": "cpu",
                "source_model": "model",
                "optimizer_args": {
                    "path": "torch.optim.SGD",
                    "args": {
                        "lr": 1.0,
                        "momentum": 0.6
                    },
                    "config_type": "dict"
                },
                "lr_scheduler_args": {
                    "path": "torch.optim.lr_scheduler.CosineAnnealingLR",
                    "args": {
                        "T_max": "{num_rounds}",
                        "eta_min": 0.8
                    },
                    "config_type": "dict"
                }
            }
        },
        {
            "id": "aggregator",
            "name": "InTimeAccumulateWeightedAggregator",
            "args": {
                "expected_data_kind": "WEIGHT_DIFF"
            }
        },
        {
            "id": "metric_logger",
            "path": "fl_bench.medmnist.src.metric_logger.GlobalMetricLogger",
            "args": {
                "log_dir": "logs",
                "log_name": "accuracy"
            }
        },
        {
            "id": "model_selector",
            "name": "IntimeModelSelector",
            "args": {
                "weigh_by_local_iter": true
            }
        },
        {
            "id": "model_locator",
            "path": "fl_bench.medmnist.src.model_locator.SimpleModelLocator",
            "args": {}
        },
        {
            "id": "json_generator",
            "name": "ValidationJsonGenerator",
            "args": {}
        },
        {
            "id": "formatter",
            "path": "fl_bench.medmnist.src.simple_formatter.SimpleFormatter",
            "args": {}
        },
        {
            "id": "report_generator",
            "path": "fl_bench.medmnist.src.report_generator.ReportGenerator",
            "args": {}
        }
    ],
    "workflows": [
        {
            "id": "scatter_and_gather",
            "name": "ScatterAndGather",
            "args": {
                "min_clients": "{min_clients}",
                "num_rounds": "{num_rounds}",
                "start_round": 0,
                "wait_time_after_min_received": 1,
                "aggregator_id": "aggregator",
                "persistor_id": "persistor",
                "shareable_generator_id": "shareable_generator_base",
                "train_task_name": "train",
                "train_timeout": 0,
                "task_check_period": 1
            }
        },
        {
            "id": "cross_site_model_eval",
            "name": "CrossSiteModelEval",
            "args": {
                "model_locator_id": "model_locator",
                "formatter_id": "formatter",
                "submit_model_timeout": 600,
                "validation_timeout": 6000,
                "cleanup_models": true
            }
        }
    ]
}