{
    "format_version": 2,
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_common.executors.learner_executor.LearnerExecutor",
                "args": {
                    "learner_id": "cifar10-learner"
                }
            }
        }
    ],
    "task_result_filters": [],
    "task_data_filters": [],
    "components": [
        {
            "id": "cifar10-learner",
            "path": "fl_bench.cifar10.pt.learners.cifar10_learner.CIFAR10Learner",
            "args": {
                "aggregation_epochs": 200,
                "lr": 0.01,
                "central": true,
                "model_arch": "MobileNetv2"
            }
        }
    ],
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/res/cifar10_splits/cifar10_central2_num_rounds=1_lr=0.01_epochs=200_model=MobileNetv2_alpha=0.6"
}