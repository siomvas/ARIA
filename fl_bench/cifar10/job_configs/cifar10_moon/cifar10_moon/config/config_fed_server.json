{
    "format_version": 2,
    "min_clients": 10,
    "num_rounds": 250,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/res/cifar10_splits/cifar10_moon",
    "alpha": 0.6,
    "server": {
        "heart_beat_timeout": 600
    },
    "task_data_filters": [],
    "task_result_filters": [],
    "components": [
        {
            "id": "data_splitter",
            "path": "fl_bench.utils.cifar10_helpers.Cifar10DataSplitter",
            "args": {
                "split_dir": "{TRAIN_SPLIT_ROOT}",
                "num_sites": "{min_clients}",
                "alpha": "{alpha}"
            }
        },
        {
            "id": "model",
            "path": "{model_path}",
            "args": {}
        },
        {
            "id": "persistor",
            "name": "PTFileModelPersistor",
            "args": {
                "model": "model"
            }
        },
        {
            "id": "shareable_generator",
            "name": "FullModelShareableGenerator",
            "args": {}
        },
        {
            "id": "aggregator",
            "name": "InTimeAccumulateWeightedAggregator",
            "args": {}
        },
        {
            "id": "model_selector",
            "name": "IntimeModelSelector",
            "args": {
                "weigh_by_local_iter": true
            }
        },
        {
            "id": "model_locator",
            "name": "PTFileModelLocator",
            "args": {
                "pt_persistor_id": "persistor"
            }
        },
        {
            "id": "json_generator",
            "name": "ValidationJsonGenerator",
            "args": {}
        }
    ],
    "workflows": [
        {
            "id": "scatter_gather_ctl",
            "name": "ScatterAndGather",
            "args": {
                "min_clients": "{min_clients}",
                "num_rounds": "{num_rounds}",
                "start_round": 0,
                "wait_time_after_min_received": 1,
                "aggregator_id": "aggregator",
                "persistor_id": "persistor",
                "shareable_generator_id": "shareable_generator",
                "train_task_name": "train",
                "train_timeout": 0
            }
        },
        {
            "id": "global_model_eval",
            "name": "GlobalModelEval",
            "args": {
                "model_locator_id": "model_locator",
                "validation_timeout": 6000,
                "cleanup_models": true
            }
        }
    ],
    "model_path": "fl_bench.networks.cifar10_nets.swin"
}