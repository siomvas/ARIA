{
    "format_version": 2,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/res/cifar10_splits/cifar10_moon",
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_common.executors.learner_executor.LearnerExecutor",
                "args": {
                    "learner_id": "cifar10-learner"
                }
            }
        }
    ],
    "task_result_filters": [],
    "task_data_filters": [],
    "components": [
        {
            "id": "cifar10-learner",
            "path": "fl_bench.cifar10.pt.learners.cifar10_moon_learner.CIFAR10MoonLearner",
            "args": {
                "train_idx_root": "{TRAIN_SPLIT_ROOT}",
                "aggregation_epochs": 4,
                "model_arch": "swin",
                "save_freq": 2,
                "lr": 0.01,
                "moon_mu": 5,
                "moon_tau": 0.5
            }
        }
    ]
}