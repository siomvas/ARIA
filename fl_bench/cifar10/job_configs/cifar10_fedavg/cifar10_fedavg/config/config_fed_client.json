{
    "format_version": 2,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/res/cifar10_splits/cifar10_fedavg_num_rounds=2_lr=0.0001_epochs=2_alpha=1.0_fa2dfb5a-50b6-470c-a079-00c5bb39cf22",
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_common.executors.learner_executor.LearnerExecutor",
                "args": {
                    "learner_id": "cifar10-learner"
                }
            }
        }
    ],
    "task_result_filters": [],
    "task_data_filters": [],
    "components": [
        {
            "id": "cifar10-learner",
            "path": "fl_bench.cifar10.pt.learners.cifar10_learner.CIFAR10Learner",
            "args": {
                "train_idx_root": "{TRAIN_SPLIT_ROOT}",
                "aggregation_epochs": 2,
                "lr": 0.0001
            }
        }
    ]
}