{
    "format_version": 2,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/surg_res/alpha10_2",
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_common.executors.learner_executor.LearnerExecutor",
                "args": {
                    "learner_id": "cifar10-learner"
                }
            }
        }
    ],
    "task_result_filters": [],
    "task_data_filters": [],
    "components": [
        {
            "id": "cifar10-learner",
            "path": "fl_bench.cifar10.pt.learners.cifar10_learner.CIFAR10Learner",
            "args": {
                "train_idx_root": "{TRAIN_SPLIT_ROOT}",
                "aggregation_epochs": 4,
                "lr": 0.01,
                "model_arch": "wideresnet_16_8_moon",
                "save_freq": 2
            }
        }
    ]
}