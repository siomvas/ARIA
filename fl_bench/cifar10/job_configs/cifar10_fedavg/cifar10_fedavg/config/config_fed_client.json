{
    "format_version": 2,
    "TRAIN_SPLIT_ROOT": "/path/to/FL_bench/res/cifar10_splits/cifar10_fedavg_num_rounds=30_lr=0.01_epochs=10_model=wideresnet_16_8_alpha=0.6",
    "executors": [
        {
            "tasks": [
                "train",
                "submit_model",
                "validate"
            ],
            "executor": {
                "id": "Executor",
                "path": "nvflare.app_common.executors.learner_executor.LearnerExecutor",
                "args": {
                    "learner_id": "cifar10-learner"
                }
            }
        }
    ],
    "task_result_filters": [],
    "task_data_filters": [],
    "components": [
        {
            "id": "cifar10-learner",
            "path": "fl_bench.cifar10.pt.learners.cifar10_learner_savemore.CIFAR10Learner_savemore",
            "args": {
                "train_idx_root": "{TRAIN_SPLIT_ROOT}",
                "aggregation_epochs": 10,
                "lr": 0.01,
                "model_arch": "wideresnet_16_8",
                "save_freq": 2
            }
        }
    ]
}